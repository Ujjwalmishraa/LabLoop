# ---- Core ----
NODE_ENV=development
PORT=5050
MONGO_URI=mongodb://127.0.0.1:27017/nidaansetu
# Comma-separated list of web origins allowed by CORS
CLIENT_ORIGIN=http://localhost:5173
# Public URL of this API (used in signed report links for the local storage driver)
PUBLIC_API_URL=http://localhost:5173

# ---- Secrets (required in production, min 32 chars each) ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
FILE_URL_SECRET=
OTP_SECRET=

# ---- Auth ----
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_COST=12
# lax when web and API share a site; none (HTTPS only) when they are on different domains
COOKIE_SAMESITE=lax

# ---- Report storage: local | s3 | cloudinary ----
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=storage/private
SIGNED_URL_TTL_SEC=600
# S3 (bucket must block public access). Credentials via AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY or an IAM role.
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT=
# Cloudinary: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# ---- Email (credentials + password reset). Without SMTP_HOST, emails are printed to the console in dev. ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=LabLoop <no-reply@nidaansetu.in>

# ---- Jobs ----
# Weekly settlement: Monday 06:00 (TZ_NAME)
SETTLEMENT_CRON=0 6 * * 1
CRON_ENABLED=true
TZ_NAME=Asia/Kolkata
