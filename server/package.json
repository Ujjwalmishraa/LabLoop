{
  "name": "nidaansetu-server",
  "version": "1.0.0",
  "private": true,
  "description": "NidaanSetu API",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "NODE_ENV=test node --experimental-vm-modules ../node_modules/jest/bin/jest.js --runInBand",
    "create-admin": "node src/scripts/create-admin.js",
    "seed:dev": "node src/scripts/seed-dev.js",
    "e2e:server": "node src/scripts/e2e-server.js",
    "migrate:labloop": "node src/scripts/migrate-labloop.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1173.0",
    "@aws-sdk/s3-request-presigner": "^3.1173.0",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.2",
    "multer": "^2.5.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.2"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ],
    "testTimeout": 30000,
    "setupFiles": [
      "<rootDir>/tests/env.js"
    ]
  }
}
